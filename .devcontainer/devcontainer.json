{
  "name": "Space Packet Parser",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "astral-sh.ty",
        "ms-python.debugpy",
        "ms-python.vscode-python-envs",
        "ms-python.mypy-type-checker",
        "ms-python.pytest",
        "ms-vscode.live-server",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-xml",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "anthropic.claude-code"
      ],
      "settings": {
        "git.detectWorktrees": true,
        "dev.containers.copyGitConfig": true,
        "python.terminal.activateEnvironment": false,
        "python-envs.terminal.autoActivationType": "command",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": ["."],
        "debugpy.debugJustMyCode": false,
        "files.associations": {
          "*.xtce": "xml"
        },
        "[python][markdown]": {
          "editor.rulers": [120]
        },
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports.ruff": "explicit"
        },
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "ruff.organizeImports": true,
        "ruff.fixAll": true,
        "ruff.format.preview": true,
        "python.languageServer": "None",
        "ty.disableLanguageServices": false
      },
      "launch": {
        "configurations": [
          {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
          }
        ]
      }
    }
  },
  "remoteUser": "root",
  "remoteEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/workspaces/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "COMMIT_GPGSIGN": "true",
    "TAG_GPGSIGN": "true"
  },
  "postCreateCommand": "/usr/local/bin/setup-dev-environment.sh",
  "postStartCommand": "/usr/local/bin/post-start.sh"
}
